  "components": {
    "schemas": {
      "PartialInput": {
        "type": "object",
        "properties": {
          "minutes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "note": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RejectInput": {
        "type": "object",
